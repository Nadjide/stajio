# OLLAMA_BASE_URL: URL of your local Ollama server.
# Default is usually http://127.0.0.1:11434
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# OLLAMA_MODEL: Local model used by the app for AI features.
# Example: phi4-mini, mistral, qwen2.5
OLLAMA_MODEL="phi4-mini"

# OLLAMA_NUM_CTX: context window requested from Ollama, in tokens. Stajio refuses a
# selection of notes that does not fit instead of letting the model truncate it.
# Higher values accept longer journals but need more memory.
OLLAMA_NUM_CTX="8192"

# OLLAMA_TIMEOUT_MS: maximum duration of one generation before it is stopped.
OLLAMA_TIMEOUT_MS="300000"

# JWT_SECRET: dedicated random secret of at least 32 bytes; required in production.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Development without a secret uses a random process secret: restarting signs out users.
JWT_SECRET=""

# false for local HTTP; set true when serving the app through HTTPS.
STAJIO_COOKIE_SECURE="false"
