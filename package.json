{
  "name": "stajio",
  "private": true,
  "version": "1.0.0",
  "description": "Application local-first pour suivre son stage ou son alternance, avec une IA locale facultative (Ollama).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nadjide/stajio.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "tsc --noEmit",
    "lint:code": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:recover": "node scripts/db-recover.mjs",
    "account:reset-password": "node scripts/reset-password.mjs",
    "check": "npm run lint && npm run lint:code && npm run test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.2.1",
    "globals": "^15.9.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5"
  }
}
